rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write access to config collection
    match /config/{document=**} {
      allow read, write: if true; // Allow all access for now
    }
    
    // Allow read access to logs for authenticated users
    match /email_logs/{document=**} {
      allow read: if request.auth != null;
      allow write: if true; // Allow all writes for now
    }
    
    match /transaction_logs/{document=**} {
      allow read: if request.auth != null;
      allow write: if true; // Allow all writes for now
    }
  }
} 