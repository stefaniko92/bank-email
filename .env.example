# Production deployment (Vercel etc.): set these in your platform's environment variables.

# AI provider: openai | anthropic
AI_PROVIDER=anthropic

# For OpenAI
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# For Anthropic
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Database (Neon etc.)
DATABASE_URL=postgresql://...

# Google Sheets backup (optional)

# Opcija A: Service Account JSON (ako org policy dozvoljava ključeve)
# GOOGLE_SHEETS_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"...@....iam.gserviceaccount.com",...}

# Opcija B: Workload Identity Federation – BEZ ključeva (ako org policy blokira)
# 1. Podesi Workload Identity Pool u GCP – vidi https://vercel.com/docs/oidc/gcp
# 2. Uključi OIDC za projekat u Vercel (Project Settings)
# 3. Podeli spreadsheet sa email-om Service Accounta
GCP_PROJECT_NUMBER=1234567890
GCP_SERVICE_ACCOUNT_EMAIL=vercel@project.iam.gserviceaccount.com
GCP_WORKLOAD_IDENTITY_POOL_ID=vercel
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel

GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_from_url

# Webhook (optional)
# WEBHOOK_CHUNK_SIZE=50

# AWS SES for failure notifications (optional)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# SES_FROM_EMAIL=
# SES_TO_EMAIL=
