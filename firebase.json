{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/v1/email/receive",
        "function": "emailReceive"
      },
      {
        "source": "/api/v1/webhook-config",
        "function": "webhookConfig"
      },
      {
        "source": "/api/v1/webhook-config/test",
        "function": "testWebhook"
      },
      {
        "source": "/api/v1/google-credentials",
        "function": "googleCredentials"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  }
} 